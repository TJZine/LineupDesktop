+TEST(AccessibilityBridgeTest,
+     RecoveryFailureStagesDoNotPublishOrPoisonLaterEvents) {
+  for (int fail_call : {1, 2, 3}) {
+    for (bool partial : {false, true}) {
+      auto bridge = std::make_shared<RecoveryTestBridge>();
+      std::vector<int32_t> root_children{1, 2};
+      std::vector<int32_t> left_children{3};
+      auto root = CreateSemanticsNode(0, "root", &root_children);
+      bridge->AddFlutterSemanticsNodeUpdate(root);
+      bridge->AddFlutterSemanticsNodeUpdate(
+          CreateSemanticsNode(1, "left", &left_children));
+      bridge->AddFlutterSemanticsNodeUpdate(CreateSemanticsNode(2, "right"));
+      bridge->AddFlutterSemanticsNodeUpdate(CreateSemanticsNode(3, "leaf"));
+      bridge->CommitUpdates();
+      auto held = bridge->GetFlutterPlatformNodeDelegateFromID(3).lock();
+      ui::AXActionData initial_focus;
+      initial_focus.action = ax::mojom::Action::kFocus;
+      EXPECT_TRUE(held->AccessibilityPerformAction(initial_focus));
+      auto* old_tree = bridge->GetTree();
+      bridge->event_targets.clear();
+      bridge->accessibility_events.clear();
+      bridge->calls = 0;
+      bridge->fail_on_call = fail_call;
+      bridge->fail_after_mutation = partial;
+      bridge->AddFlutterSemanticsNodeUpdate(CreateSemanticsNode(1, "left"));
+      bridge->AddFlutterSemanticsNodeUpdate(
+          CreateSemanticsNode(2, "right", &left_children));
+      bridge->CommitUpdates();
+      EXPECT_EQ(old_tree, bridge->GetTree());
+      EXPECT_TRUE(bridge->GetTree()->error().empty());
+      EXPECT_EQ(held->GetAXNode()->parent()->id(), 1);
+      EXPECT_EQ(held->GetName(), "leaf");
+      EXPECT_TRUE(bridge->event_targets.empty());
+      EXPECT_TRUE(bridge->GetPendingEvents().empty());
+      bridge->fail_on_call = 0;
