+  // controller and its view are still alive and loaded.
+  auto bridge = std::make_shared<AccessibilityBridgeMac>(engine, viewController);
+  FlutterSemanticsFlags flags{};
+  FlutterSemanticsFlags text_flags{.is_text_field = true};
+  std::vector<int32_t> children{1};
+  FlutterSemanticsNode2 root{};
+  root.id = 0;
+  root.flags2 = &flags;
+  root.child_count = children.size();
+  root.children_in_traversal_order = children.data();
+  root.transform = {1, 0, 0, 0, 1, 0, 0, 0, 1};
+  FlutterSemanticsNode2 field{};
+  field.id = 1;
+  field.flags2 = &text_flags;
+  field.value = "retained text";
+  field.text_selection_base = -1;
+  field.text_selection_extent = -1;
+  field.rect = {0, 0, 50, 50};
+  field.transform = root.transform;
+  bridge->AddFlutterSemanticsNodeUpdate(root);
+  bridge->AddFlutterSemanticsNodeUpdate(field);
+  bridge->CommitUpdates();
+  auto held = bridge->GetFlutterPlatformNodeDelegateFromID(1).lock();
+  ASSERT_TRUE(held);
+  FlutterTextField* native = (FlutterTextField*)held->GetNativeViewAccessible();
+  ASSERT_TRUE(native);
+  EXPECT_TRUE([native isDescendantOf:viewController.view]);
+  (void)native.frame;
+  root.child_count = 0;
+  bridge->AddFlutterSemanticsNodeUpdate(root);
+  bridge->CommitUpdates();
+  EXPECT_EQ(held->GetAXNode(), nullptr);
+  EXPECT_TRUE(NSEqualRects(native.frame, NSZeroRect));
+  EXPECT_EQ(native.superview, nil);
