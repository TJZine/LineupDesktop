+  engine.semanticsEnabled = YES;
+  auto bridge = viewController.accessibilityBridge.lock();
+  FlutterSemanticsFlags flags{};
+  std::vector<int32_t> root_children{1, 2};
+  std::vector<int32_t> left_children{3};
+  std::vector<int32_t> descendant{4};
+  auto add = [&](int32_t id, const char* label, const std::vector<int32_t>& children) {
+    FlutterSemanticsNode2 node{};
+    node.id = id;
+    node.flags2 = &flags;
+    node.label = label;
+    node.text_selection_base = -1;
+    node.text_selection_extent = -1;
+    node.child_count = children.size();
+    node.children_in_traversal_order = children.data();
+    node.transform = {1, 0, 0, 0, 1, 0, 0, 0, 1};
+    bridge->AddFlutterSemanticsNodeUpdate(node);
+  };
+  add(0, "root", root_children);
+  add(1, "left", left_children);
+  add(2, "right", {});
+  add(3, "subtree", descendant);
+  add(4, "leaf", {});
+  bridge->CommitUpdates();
+  auto held = bridge->GetFlutterPlatformNodeDelegateFromID(4).lock();
+  ASSERT_TRUE(held);
+  id native = held->GetNativeViewAccessible();
+  add(1, "left", {});
+  add(2, "right", left_children);
+  bridge->CommitUpdates();
+  EXPECT_EQ(held, bridge->GetFlutterPlatformNodeDelegateFromID(4).lock());
+  EXPECT_EQ(native, held->GetNativeViewAccessible());
