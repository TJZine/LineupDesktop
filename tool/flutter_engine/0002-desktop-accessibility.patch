+// Regression fixtures use real AXTree updates and retain a single bridge.
+class RecoveryTestBridge : public TestAccessibilityBridge {
+ public:
+  int fail_on_call = 0;
+  int calls = 0;
+  bool fail_after_mutation = false;
+  std::vector<AccessibilityNodeId> event_targets;
+
+ protected:
+  bool ApplyAXTreeUpdate(ui::AXTree& tree,
+                         const ui::AXTreeUpdate& update) override {
+    if (++calls != fail_on_call) {
+      return tree.Unserialize(update);
+    }
+    ui::AXTreeUpdate broken;
+    ui::AXNodeData node;
+    if (fail_after_mutation) {
+      if (tree.root()->id() == ui::AXNode::kInvalidAXID) {
+        EXPECT_TRUE(tree.Unserialize(update));
+      }
+      // A placeholder is created and the root data changes before completion
+      // rejects the missing child record. This is a real partial-mutation path.
+      node = tree.root()->data();
+      node.SetName("partially mutated staged root");
+      node.child_ids.push_back(987654);
+    } else {
+      node.id = 987654;
+    }
+    broken.nodes.push_back(node);
+    EXPECT_FALSE(tree.Unserialize(broken));
+    return false;
+  }
+
+  void OnAccessibilityEvent(
+      ui::AXEventGenerator::TargetedEvent event) override {
+    EXPECT_EQ(event.node, GetTree()->GetFromId(event.node->id()));
+    event_targets.push_back(event.node->id());
+    TestAccessibilityBridge::OnAccessibilityEvent(event);
+  }
+};
