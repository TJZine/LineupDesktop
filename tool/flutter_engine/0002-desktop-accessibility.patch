+  ASSERT_TRUE(native_again);
+  bridge.reset();
+  EXPECT_TRUE(viewController.viewLoaded);
+  EXPECT_EQ(held_again->GetAXNode(), nullptr);
+  EXPECT_TRUE(NSEqualRects(native_again.frame, NSZeroRect));
+  EXPECT_EQ(native_again.superview, nil);
+  [native_again setAccessibilityFocused:YES];
+  [native_again startEditing];
+  [engine shutDownEngine];
+}
