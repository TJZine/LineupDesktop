+TEST(AccessibilityBridgeTest,
+     RecoveryNestedMovesAndDeletedAncestorsRetainData) {
+  auto bridge = std::make_shared<TestAccessibilityBridge>();
+  std::vector<int32_t> c0{1};
+  std::vector<int32_t> c1{2};
+  std::vector<int32_t> c2{3};
+  std::vector<int32_t> c3{4};
+  bridge->AddFlutterSemanticsNodeUpdate(CreateSemanticsNode(0, "root", &c0));
+  bridge->AddFlutterSemanticsNodeUpdate(CreateSemanticsNode(1, "one", &c1));
+  bridge->AddFlutterSemanticsNodeUpdate(CreateSemanticsNode(2, "two", &c2));
+  bridge->AddFlutterSemanticsNodeUpdate(CreateSemanticsNode(3, "three", &c3));
+  bridge->AddFlutterSemanticsNodeUpdate(CreateSemanticsNode(4, "four"));
+  bridge->CommitUpdates();
+  auto held = bridge->GetFlutterPlatformNodeDelegateFromID(4).lock();
+  // Reverse the nested parent relationship and move an omitted leaf while
+  // deleting its old top-level ancestor.
+  c0 = {3};
+  c2 = {4};
+  c3 = {2};
+  bridge->AddFlutterSemanticsNodeUpdate(CreateSemanticsNode(0, "root", &c0));
+  bridge->AddFlutterSemanticsNodeUpdate(CreateSemanticsNode(2, "two", &c2));
+  bridge->AddFlutterSemanticsNodeUpdate(CreateSemanticsNode(3, "three", &c3));
+  bridge->CommitUpdates();
+  EXPECT_EQ(held, bridge->GetFlutterPlatformNodeDelegateFromID(4).lock());
+  EXPECT_EQ(held->GetAXNode()->parent()->id(), 2);
+  EXPECT_EQ(held->GetAXNode()->parent()->parent()->id(), 3);
+  EXPECT_TRUE(bridge->GetFlutterPlatformNodeDelegateFromID(1).expired());
+  EXPECT_EQ(held->GetName(), "four");
+}
